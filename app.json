{
  "expo": {
    "name": "Road Monitor",
    "slug": "road-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fyp.roadmonitor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fyp.roadmonitor"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "roadmonitor",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Road Monitor uses the camera to inspect the road surface for potholes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Road Monitor uses your location to tag each detection with GPS coordinates."
        }
      ]
    ],
    "backgroundColor": "#0F1113"
  }
}
